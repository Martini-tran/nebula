{
  "name": "nebula-forge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,docs -c cyan,green \"vite\" \"vitepress dev docs\"",
    "dev:app": "vite",
    "build": "vue-tsc -b && vite build && vitepress build docs",
    "build:app": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@imengyu/vue3-context-menu": "^1.5.4",
    "@tailwindcss/vite": "^4.2.2",
    "axios": "^1.15.2",
    "md-editor-v3": "^6.4.2",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.2",
    "three": "^0.184.0",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "sass": "^1.99.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.2.6"
  }
}
