# Nebula 北京节点部署配置模板
#
# 用法：
#   cp deploy/.env.example deploy/.env && vi deploy/.env
#
# deploy/.env 已被 .gitignore 排除，绝不要提交。
# 标记 [必填] 的项没有默认值，compose 会在启动时直接报错退出（?: 语法），
# 这是刻意设计——宁可起不来，也不要用弱默认密码裸奔上线。
#
# 生成强随机值：openssl rand -base64 24

# ---------- 版本 ----------
# 与根 pom.xml 的 <revision> 保持一致；发布正式版时改成 1.0.4。
NEBULA_VERSION=1.0.4-SNAPSHOT

# ---------- 网络绑定 ----------
# Gateway 对外监听地址。生产必须填北京服务器的 WireGuard 内网 IP（如 10.8.0.2），
# 让首尔经私网访问；填 0.0.0.0 等于把 19000 挂上公网。
GATEWAY_BIND_ADDR=127.0.0.1

# ---------- MySQL [必填] ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nebula
MYSQL_USERNAME=nebula
MYSQL_PASSWORD=

# ---------- Redis [必填] ----------
# 存 sa-token 会话，五个服务共享同一实例与 namespace。
REDIS_PASSWORD=

# ---------- MinIO [必填] ----------
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 私有桶：走后端预签名 URL 访问
MINIO_PRIVATE_BUCKET=nebula
# 公开桶：由 minio-init 容器设为匿名只读，返回永久直链
MINIO_PUBLIC_BUCKET=public
# [必填] 公开桶对外域名。后端用它拼接返回给浏览器的直链，
# 留空会拼出容器内的 minio:9000，浏览器无法解析 —— 这是最容易踩的坑。
MINIO_PUBLIC_DOMAIN=https://s3.example.com
# MinIO 控制台对外地址（仅经 WireGuard/SSH 隧道访问，不要挂公网）
MINIO_CONSOLE_URL=http://127.0.0.1:9001

# ---------- Meilisearch [必填] ----------
# blog 和 forge 的全文检索依赖它；架构文档早期版本漏了这个组件。
MEILISEARCH_API_KEY=

# ---------- AI 运行时 [必填] ----------
# manager 与 blog 都启用了 nebula.ai，缺 Key 会导致流程编排相关功能不可用。
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# [必填] ai_model_profile 表中 apiKey 的可逆加密密钥。
# 管理端写入与运行时读取共用此值；上线后修改会导致历史档案无法解密。
AI_PROFILE_SECRET=

# ---------- Embedding（向量化）----------
# 与聊天模型解耦，通常来自不同厂商。DeepSeek 当前不提供 embedding 端点，
# 若 MILVUS_ENABLED=true，这里应指向真正支持 embedding 的服务（如 OpenAI）。
AI_EMBEDDING_ENABLED=true
AI_EMBEDDING_CODE=openai
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
# 强约束：必须与 Milvus collection 的建库维度一致。
# 修改维度需按《向量检索迁移runbook》走 alias 切换，不能直接覆盖旧 collection。
AI_EMBEDDING_DIMENSION=1536

# ---------- Milvus（阿里云杭州托管）----------
# 首次部署建议保持 false，等核心链路验证通过再开启向量检索。
MILVUS_ENABLED=false
# Zilliz Cloud Endpoint（含 https://；填写后优先于 host/port）
MILVUS_URI=
# 自建 Milvus 的主机地址（仅在 MILVUS_URI 为空时使用，不含协议和端口）
MILVUS_HOST=
MILVUS_PORT=19530
# 自建实例可填 user:password；Zilliz Cloud 填控制台生成的访问令牌
MILVUS_TOKEN=
MILVUS_DATABASE=default
# 托管实例走 TLS，务必 true；自建明文实例才用 false
MILVUS_SECURE=true
